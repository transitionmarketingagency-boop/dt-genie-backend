{
  "name": "dt-genie-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server/index-prod.js",
  "engines": {
    "node": ">=20 <22"
  },
  "scripts": {
    "dev": "node server/index.js",
    "build": "tsc && npm run copy-public && npm run copy-personas && npm run copy-ai-logic && npm run copy-chunks && npm run copy-utils",
    "start": "node dist/server/index-prod.js",
    "copy-public": "cpx \"public/**/*\" dist/public",
    "copy-personas": "cpx \"personas/**/*\" dist/personas",
    "copy-ai-logic": "cpx \"server/ai_logic/**/*.json\" dist/server/ai_logic --preserve",
    "copy-chunks": "cpx \"server/vector_store/chunks.json\" dist/server/vector_store/",
    "copy-utils": "cpx \"server/utils/**/*.ts\" dist/server/utils/"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "sqlite3": "^5.1.6",
    "undici": "^5.29.0"
  },
  "overrides": {
    "undici": "^5.29.0"
  }
}
