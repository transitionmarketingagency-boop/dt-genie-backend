{
  "name": "dt-genie-backend",
  "version": "1.0.0",
  "description": "Backend for DT Genie",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "dev": "tsx server/app.ts",
    "frontend": "vite",

    "build": "tsc -p tsconfig.build.json && npm run copy-public && npm run copy-db",
    "build:backend": "npm run build",

    "copy-public": "mkdirp dist/public && cpy \"public/**/*\" dist/public",
    "copy-db": "mkdirp dist/server/vector_store && copy server\\vector_store\\unified_chunks.db dist\\server\\vector_store\\unified_chunks.db",

    "start": "node dist/server/index-prod.js",
    "postinstall": "echo 'Skipping Python install on Render'"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.13.2",
    "better-sqlite3": "^12.6.0",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "google-auth-library": "^10.5.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^4.0.2",
    "node-fetch": "^3.3.2",
    "pdf-parse": "^1.1.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "uuid": "^9.0.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.29",
    "cpy-cli": "^6.0.0",
    "mkdirp": "^3.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT"
}
