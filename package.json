{
  "name": "dt-genie-backend",
  "version": "1.0.0",
  "description": "DT-Genie backend services",
  "main": "dist/server/index-prod.js",
  "type": "module",
  "engines": {
    "node": "20.18.x"
  },
  "scripts": {
    "build": "tsc && npm run copy-public && npm run copy-personas && npm run copy-ai-logic && npm run copy-chunks && npm run copy-utils",
    "build:backend": "npm run build",
    "start": "node dist/server/index-prod.js",
    "test-embedding": "tsx server/services/testEmbedding.ts",
    "test-hybrid": "tsx server/testHybridSystem.ts",
    "test-full": "tsx server/utils/full_system_test.ts",
    "test-all": "npm run test-embedding && npm run test-hybrid && npm run test-full",
    "diag-full": "npm run test-all",
    "copy-public": "cpx \"public/**/*\" dist/public",
    "copy-personas": "cpx \"personas/**/*\" dist/personas",
    "copy-ai-logic": "cpx \"server/ai_logic/**/*\" dist/server/ai_logic",
    "copy-chunks": "cpx \"server/vector_store/chunks.json\" dist/server/vector_store/",
    "copy-utils": "cpx \"server/utils/**/*.py\" dist/server/utils/",
    "diag-qwen": "tsx server/utils/diagnosticQwenTest.ts"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "better-sqlite3": "^12.6.2",
    "chalk": "^5.6.2",
    "cheerio": "^1.0.2-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.19.1",
    "express-rate-limit": "^6.9.0",
    "google-auth-library": "^10.5.0",
    "mkdirp": "^1.0.4",
    "node-fetch": "^3.3.2",
    "pdf-parse": "^1.1.1",
    "sqlite": "^4.2.1",
    "sqlite3": "^5.1.7",
    "uuid": "^9.0.0",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.33",
    "@types/cors": "^2.8.13",
    "@types/cpx": "^1.5.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/node": "^20.19.33",
    "@types/node-fetch": "^2.6.3",
    "@types/pdf-parse": "^1.1.3",
    "@types/sqlite3": "^3.1.11",
    "cpx": "^1.5.0",
    "ts-node": "^10.9.2",
    "tsx": "^3.14.0",
    "typescript": "^5.9.3"
  }
}
