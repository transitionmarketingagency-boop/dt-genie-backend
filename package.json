{
  "name": "dt-genie-backend",
  "version": "1.0.0",
  "description": "DT-Genie backend services",
  "main": "dist/server/index-prod.js",
  "type": "module",
  "engines": {
    "node": "20.18.x"
  },
  "scripts": {
    "build": "tsc && npm run copy-public && npm run copy-personas && npm run copy-chunks && npm run copy-utils",
    "build:backend": "npm run build",
    "start": "node dist/server/index-prod.js",
    "neon:admin": "node --import tsx scripts/neon-admin/server.mjs",
    "diag-qwen": "tsx server/utils/diagnosticQwenTest.ts",
    "copy-public": "node scripts/copy-runtime-assets.mjs tree public dist/public",
    "copy-personas": "node scripts/copy-runtime-assets.mjs optional-tree personas dist/personas",
    "copy-chunks": "node scripts/copy-runtime-assets.mjs file server/vector_store/chunks.json dist/server/vector_store/chunks.json",
    "copy-utils": "node scripts/copy-runtime-assets.mjs ts-tree server/utils dist/server/utils"
  },
  "dependencies": {
    "axios": "^1.15.0",
    "better-sqlite3": "^12.6.2",
    "chalk": "^5.6.2",
    "cheerio": "^1.0.2-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "esbuild": "^0.28.0",
    "express": "^4.19.1",
    "express-rate-limit": "^6.9.0",
    "google-auth-library": "^10.5.0",
    "mammoth": "^1.13.0",
    "mkdirp": "^1.0.4",
    "multer": "^2.5.0",
    "pdf-parse": "^1.1.1",
    "sqlite": "^4.2.1",
    "sqlite3": "^5.1.7",
    "tar": "^7.5.22",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "overrides": {
    "qs": "^6.16.1",
    "tar": "^7.5.22",
    "@tootallnate/once": "^2.0.1"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.33",
    "@types/cors": "^2.8.13",
    "@types/express-rate-limit": "^5.1.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.19.33",
    "@types/node-fetch": "^2.6.3",
    "@types/pdf-parse": "^1.1.3",
    "@types/sqlite3": "^3.1.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
