{
  "name": "dt-genie-backend",
  "version": "1.0.0",
  "description": "Backend for DT Genie",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "dev": "tsx server/app.ts",
    "frontend": "vite",
    "build": "tsc -p tsconfig.build.json",
    "build:backend": "tsc -p tsconfig.build.json && npm run copy-public && npm run copy-db",
    "copy-public": "mkdirp dist/public && cpy \"public/**/*\" dist/public",
    "copy-db": "mkdirp dist/server/vector_store && cpy server/vector_store/unified_chunks.db dist/server/vector_store",
    "start": "node dist/index-prod.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@replit/vite-plugin-cartographer": "^0.4.4",
    "@replit/vite-plugin-dev-banner": "^0.1.1",
    "@replit/vite-plugin-runtime-error-modal": "^0.0.3",
    "@tanstack/react-query": "^5.90.11",
    "@vitejs/plugin-react": "^5.1.1",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.13.2",
    "better-sqlite3": "^12.5.0",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.7",
    "drizzle-zod": "^0.8.3",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "google-auth-library": "^10.5.0",
    "lucide-react": "^0.555.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^4.0.2",
    "node-fetch": "^3.3.2",
    "pdf-parse": "^1.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "tailwind-merge": "^3.4.0",
    "uuid": "^9.0.1",
    "vite": "^7.2.4",
    "wouter": "^3.8.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.27",
    "@types/node-fetch": "^2.6.13",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/sqlite3": "^3.1.11",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "cpy-cli": "^6.0.0",
    "mkdirp": "^3.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT"
}
