{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": [
    "server/index-prod.ts",
    "server/app.ts",
    "server/routes.ts",
    "server/services/**/*.ts",
    "server/queryChunks.ts",
    "server/populate-test-data.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts",
    "server/test-*",
    "server/**/test-*",
    "server/training_pipeline/**",
    "server/services/ollamaClient.ts",
    "server/services/geminiClient.ts",
    "server/test-*.ts"
  ]
}
