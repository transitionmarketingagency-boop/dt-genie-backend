{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "noEmitOnError": true
  },
  "include": [
    "server/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts",
    "server/test-*",
    "server/**/test-*",
    "server/**/__tests__/**",
    "server/training_pipeline/**",
    "server/services/ollamaClient.ts",
    "server/services/geminiClient.ts",
    "server/test-*.ts"
  ]
}
